[app]

# Nama aplikasi
title = Belajar Bentuk Warna

# Nama package (harus unik)
package.name = belajar.bentuk.warna

# Domain package
package.domain = org.kids

# Source directory
source.dir = .

# File utama
source.main = main.py

# Version
version = 1.0

# Requirements
requirements = python3, pygame, pycairo

# Permissions android
android.permissions = INTERNET

# Icon
# icon.filename = icon.png

# Orientation
orientation = landscape

# Fullscreen
fullscreen = 1

# Wakelock (jaga layar tetap hidup)
android.wakelock = True

# Android API
android.api = 29
android.minapi = 21
android.ndk = 23b

# Bootstrap
android.bootstrap = sdl2

# Arch
android.arch = armeabi-v7a

[buildozer]

# Log level
log_level = 2

# Warn on deprecated
warn_on_root = 1